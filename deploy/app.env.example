# Variaveis da aplicacao publicada.
#
# O arquivo real fica em /home/app-pwa-prefeitura/.config/app.env, com modo 600,
# e e criado por `criar-app` (banco) + `deploy/instalar.sh` (aplicacao).
# Nunca versione o arquivo real.

PORT=3000

# Endereco publico usado em links de e-mail e notificacoes.
APP_URL=https://digital.cujubim.ro.gov.br

# Origens aceitas pelo CORS. O uso normal e same-origin via nginx.
CORS_ORIGINS=https://digital.cujubim.ro.gov.br

# O navegador so envia o cookie de sessao por HTTPS.
COOKIE_SECURE=true

# Sem atraso artificial no ambiente publicado.
MOCK_LATENCY_MS=0

# Senha das contas demonstrativas. Gere uma senha forte no servidor.
DEMO_PASSWORD=troque-esta-senha

# Catalogo administrativo (MySQL). O banco e o usuario sao criados por
# `criar-app`; estas variaveis devem apontar para esse banco.
# Sem DB_HOST/DB_USER/DB_NAME o catalogo funciona em memoria e nao persiste.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app_pwa_prefeitura
DB_USER=app_pwa_prefeitura
DB_PASSWORD=troque-esta-senha
DB_POOL_SIZE=5
